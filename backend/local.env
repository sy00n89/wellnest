# Settings for running the backend on your own machine against dynamodb-local.
# Load into your shell with:  set -a; source local.env; set +a
DYNAMODB_ENDPOINT=http://localhost:8001
ENTRIES_TABLE=wellnest-entries
# dynamodb-local accepts any credentials, but boto3 refuses to run without some.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
